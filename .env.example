# Telegram bot tokeni (@BotFather-den)
BOT_TOKEN=
# Admin(ler)iň Telegram ID-si (birnäçe bolsa otur bilen: 111,222). ID-ni @userinfobot-dan bilip bilersiňiz
ADMIN_IDS=
# Claude API açary (https://console.anthropic.com) — prezentasiýanyň mazmunyny ýazýar
ANTHROPIC_API_KEY=
# Başga saýtdan alnan API bolsa onuň Base URL-y (mysal: https://triklz27.ru/v1). Anthropic-iň özi bolsa boş goýuň
ANTHROPIC_BASE_URL=
# Model (API üpjün edijiňizde bar bolan model ady)
CLAUDE_MODEL=claude-opus-5-5
# Her görnüş üçin aýratyn model (boş = CLAUDE_MODEL). Mysal triklz27 üçin:
#   MODEL_SIMPLE=claude-haiku-4-5  MODEL_MEDIUM=claude-haiku-4-5  MODEL_FULL=claude-fable-5-2
MODEL_SIMPLE=
MODEL_MEDIUM=
MODEL_FULL=
# Model işlemese (balans, ýalňyşlyk), bot şu modellere tertip boýunça özi geçýär
FALLBACK_MODELS=
# Islege görä: Pexels API açary (https://www.pexels.com/api) — slaýdlara hakyky suratlar goşýar
PEXELS_API_KEY=
